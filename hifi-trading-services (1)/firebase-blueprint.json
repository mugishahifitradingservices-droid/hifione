{
  "entities": {
    "User": {
      "title": "User",
      "description": "System user with RBAC profile",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 100 },
        "role": { 
          "type": "string", 
          "enum": ["MARKETING_EXECUTIVE", "MARKETING_MANAGER", "CEO", "TENDER_OFFICER", "COMMERCIAL_MANAGER", "SYSTEM_ADMINISTRATOR"] 
        },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["name", "email", "role", "createdAt", "updatedAt"]
    },
    "Organization": {
      "title": "Organization",
      "description": "Company or customer entity",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 150 },
        "address": { "type": "string", "maxLength": 250 },
        "typeOfBusiness": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 50 },
        "email": { "type": "string", "maxLength": 100 },
        "website": { "type": "string", "maxLength": 150 },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["name", "createdBy", "createdAt", "updatedAt"]
    },
    "Contact": {
      "title": "Contact",
      "description": "A person associated with an organization",
      "type": "object",
      "properties": {
        "organizationId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "position": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 50 },
        "email": { "type": "string", "maxLength": 100 },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["organizationId", "name", "createdBy", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Users and their roles"
    },
    "organizations/{organizationId}": {
      "schema": { "$ref": "#/entities/Organization" },
      "description": "Organizations"
    },
    "contacts/{contactId}": {
      "schema": { "$ref": "#/entities/Contact" },
      "description": "Contacts related to organizations"
    }
  }
}
